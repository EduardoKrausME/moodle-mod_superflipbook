<aside class="mcp-promo" aria-labelledby="mod_superflipbook-mcp-title">
    <div class="mcp-promo__icon" aria-hidden="true">MCP</div>
    <div class="mcp-promo__content">
        <span class="mcp-promo__badge">{{#str}}mcp_banner_badge,mod_superflipbook{{/str}}</span>
        <h3 id="mod_superflipbook-mcp-title">{{#str}}mcp_banner_title,mod_superflipbook{{/str}}</h3>
        <p>{{#str}}mcp_banner_description,mod_superflipbook{{/str}}</p>
        <ul>
            <li>{{#str}}mcp_banner_benefit_discovery,mod_superflipbook{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_security,mod_superflipbook{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_control,mod_superflipbook{{/str}}</li>
        </ul>
        <a class="mcp-promo__link" href="https://eduardokrausme.github.io/moodle-local_mcp/"
           target="_blank" rel="noopener noreferrer">{{#str}}mcp_banner_cta,mod_superflipbook{{/str}} &#8599;</a>
    </div>
    <form class="mcp-promo__close" method="post" action="{{mcp_banner_dismiss_url}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="dismiss_mcp_banner" value="1">
        <button class="mcp-promo__dismiss" type="submit"
            aria-label="{{#str}}mcp_banner_dismiss,mod_superflipbook{{/str}}"
            title="{{#str}}mcp_banner_dismiss,mod_superflipbook{{/str}}">&times;</button>
    </form>
</aside>
